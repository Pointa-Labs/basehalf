{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugins.basehalf.com/schemas/aivideo-v4.schema.json",
  "title": "BaseHalf AI Video project",
  "description": "A local, Agent-authored workflow made from Text, Image, Video, and Audio nodes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "nodes", "edges", "groups", "sequence", "outputs"],
  "properties": {
    "version": { "const": 4 },
    "title": { "type": "string" },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
    "sequence": { "type": "array", "items": { "$ref": "#/$defs/sequenceItem" } },
    "outputs": { "$ref": "#/$defs/paths" }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "paths": { "type": "array", "items": { "type": "string" } },
    "baseNodeProperties": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "position": { "$ref": "#/$defs/position" },
        "groupId": { "type": "string", "minLength": 1 }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "createdAt", "provider", "model", "status", "prompt", "inputPaths", "outputs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "status": { "enum": ["prepared", "complete"] },
        "prompt": { "type": "string" },
        "inputPaths": { "$ref": "#/$defs/paths" },
        "outputs": { "$ref": "#/$defs/paths" }
      }
    },
    "executableProperties": {
      "type": "object",
      "properties": {
        "source": { "enum": ["generate", "local"] },
        "prompt": { "type": "string" },
        "negativePrompt": { "type": "string" },
        "inputFiles": { "$ref": "#/$defs/paths" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "status": { "enum": ["draft", "ready", "running", "prepared", "complete", "error", "stale"] },
        "runs": { "type": "array", "items": { "$ref": "#/$defs/run" } },
        "selectedRunId": { "type": "string", "minLength": 1 },
        "error": { "type": "string" }
      }
    },
    "textNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNodeProperties" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "role", "title", "content", "position"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": { "const": "text" },
            "role": { "enum": ["brief", "script", "storyboard", "imagePrompt", "videoPrompt", "dialogue", "note"] },
            "title": { "type": "string" },
            "content": { "type": "string" },
            "width": { "type": "number", "minimum": 260, "maximum": 720 },
            "height": { "type": "number", "minimum": 180, "maximum": 900 },
            "position": { "$ref": "#/$defs/position" },
            "groupId": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "imageNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "role", "title", "position", "source", "prompt", "negativePrompt", "inputFiles", "provider", "model", "status", "runs", "aspectRatio", "count"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "image" },
        "role": { "enum": ["generate", "reference", "frame"] },
        "title": { "type": "string" },
        "position": { "$ref": "#/$defs/position" },
        "groupId": { "type": "string", "minLength": 1 },
        "source": { "enum": ["generate", "local"] },
        "prompt": { "type": "string" },
        "negativePrompt": { "type": "string" },
        "inputFiles": { "$ref": "#/$defs/paths" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "status": { "enum": ["draft", "ready", "running", "prepared", "complete", "error", "stale"] },
        "runs": { "type": "array", "items": { "$ref": "#/$defs/run" } },
        "selectedRunId": { "type": "string", "minLength": 1 },
        "error": { "type": "string" },
        "aspectRatio": { "type": "string" },
        "count": { "type": "number", "minimum": 1, "maximum": 16 }
      }
    },
    "videoNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "role", "title", "position", "source", "prompt", "negativePrompt", "inputFiles", "provider", "model", "status", "runs", "durationSeconds", "aspectRatio", "audioMode"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "video" },
        "role": { "enum": ["generate", "reference"] },
        "title": { "type": "string" },
        "position": { "$ref": "#/$defs/position" },
        "groupId": { "type": "string", "minLength": 1 },
        "source": { "enum": ["generate", "local"] },
        "prompt": { "type": "string" },
        "negativePrompt": { "type": "string" },
        "inputFiles": { "$ref": "#/$defs/paths" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "status": { "enum": ["draft", "ready", "running", "prepared", "complete", "error", "stale"] },
        "runs": { "type": "array", "items": { "$ref": "#/$defs/run" } },
        "selectedRunId": { "type": "string", "minLength": 1 },
        "error": { "type": "string" },
        "durationSeconds": { "type": "number", "minimum": 1, "maximum": 120 },
        "aspectRatio": { "type": "string" },
        "audioMode": { "enum": ["auto", "generate", "none"] }
      }
    },
    "audioNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "role", "title", "position", "source", "prompt", "negativePrompt", "inputFiles", "provider", "model", "status", "runs", "durationSeconds", "voice"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "audio" },
        "role": { "enum": ["voice", "music", "effect", "reference"] },
        "title": { "type": "string" },
        "position": { "$ref": "#/$defs/position" },
        "groupId": { "type": "string", "minLength": 1 },
        "source": { "enum": ["generate", "local"] },
        "prompt": { "type": "string" },
        "negativePrompt": { "type": "string" },
        "inputFiles": { "$ref": "#/$defs/paths" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "status": { "enum": ["draft", "ready", "running", "prepared", "complete", "error", "stale"] },
        "runs": { "type": "array", "items": { "$ref": "#/$defs/run" } },
        "selectedRunId": { "type": "string", "minLength": 1 },
        "error": { "type": "string" },
        "durationSeconds": { "type": "number", "minimum": 1, "maximum": 3600 },
        "voice": { "type": "string" }
      }
    },
    "node": { "oneOf": [{ "$ref": "#/$defs/textNode" }, { "$ref": "#/$defs/imageNode" }, { "$ref": "#/$defs/videoNode" }, { "$ref": "#/$defs/audioNode" }] },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "media"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "media": { "enum": ["text", "image", "video", "audio"] }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "position", "width", "height", "nodeIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "position": { "$ref": "#/$defs/position" },
        "width": { "type": "number", "minimum": 480, "maximum": 2400 },
        "height": { "type": "number", "minimum": 220, "maximum": 1600 },
        "nodeIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "sequenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "videoNodeId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "videoNodeId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
