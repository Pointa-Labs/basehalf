# dependencies
node_modules/

# BaseHalf local mirror/runtime state.
**/.bh/

# build output
dist/
build/
basehalf-dist/
VSCode-darwin-*/
out/
.turbo/
.vite/
.pnpm-store/
*.tsbuildinfo
tmp/
**/.terraform/
# ...but the desktop packaging assets (app icon + its source mark) are INPUTS,
# not output -- electron-builder reads them from its buildResources dir, which
# happens to be named `build/`. Un-ignore just that one.
!packages/desktop/build/
!packages/desktop/build/**
# Same story for the VS Code base: vscode-base/build/ is the BUILD SYSTEM
# (gulp tasks, packaging scripts), not output. Its own .gitignore keeps
# build/node_modules etc. out.
!vscode-base/build/

# logs / env / OS cruft
*.log
.env
.env.*
.DS_Store
.playwright-cli/

# internal/strategy docs — never commit (kept locally only)
private-docs/

# local reference checkouts for UI study (third-party source, kept local only,
# never committed — IP hygiene + keeps the repo small)
reference/

# Local interaction-research records and evidence. Product conclusions derived
# from them belong in the maintained specs; raw third-party studies stay local.
vscode-base/extensions/basehalf-ai-video/docs/*-behavior-audit*.md
vscode-base/extensions/basehalf-ai-video/docs/*-handoff-prompt*.txt
vscode-base/extensions/basehalf-ai-video/docs/*-followup-evidence/
vscode-base/extensions/basehalf-ai-video/docs/product-research*.md
vscode-base/extensions/basehalf-ai-video/docs/canvas-interaction-spec.md
vscode-base/extensions/basehalf-ai-video/docs/canvas-implementation-gap-audit.md
vscode-base/extensions/basehalf-ai-video/docs/canvas-product-conclusion*.md
vscode-base/extensions/basehalf-ai-video/docs/unified-canvas-product-contract*.md

# Claude Code runtime state (scheduled task locks, etc.)
.claude/

# WorkBuddy local project state (memories, automations, skills — local only)
.workbuddy/

# BaseHalf derived cache (rebuildable; the rest of .bh/ stays in git)
.bh/cache/
