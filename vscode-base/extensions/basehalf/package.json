{
  "name": "basehalf",
  "displayName": "BaseHalf",
  "description": "BaseHalf workspace protocol integration for VS Code.",
  "version": "0.0.1",
  "publisher": "basehalf",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.128.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:basehalf.focus",
    "onCommand:basehalf.refreshFocus",
    "onCommand:basehalf.openCurrentFocus",
    "workspaceContains:.bh/current_focus.yaml"
  ],
  "main": "./out/extension",
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "basehalf",
          "icon": "$(references)",
          "title": "BaseHalf"
        }
      ]
    },
    "views": {
      "basehalf": [
        {
          "id": "basehalf.focus",
          "name": "Current Focus"
        }
      ]
    },
    "commands": [
      {
        "command": "basehalf.refreshFocus",
        "title": "Refresh Focus",
        "category": "BaseHalf",
        "icon": "$(refresh)"
      },
      {
        "command": "basehalf.openCurrentFocus",
        "title": "Open Current Focus",
        "category": "BaseHalf",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "basehalf.openCurrentFocus",
          "when": "view == basehalf.focus",
          "group": "navigation@1"
        },
        {
          "command": "basehalf.refreshFocus",
          "when": "view == basehalf.focus",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "gulp compile-extension:basehalf",
    "watch": "gulp watch-extension:basehalf"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Pointa-Labs/basehalf.git"
  }
}
