{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": [
			"ES2024",
			"DOM",
			"DOM.Iterable"
		],
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"./**/*.ts",
		"./**/*.tsx",
		"./**/*.d.ts",
		"../src/model.ts"
	]
}
