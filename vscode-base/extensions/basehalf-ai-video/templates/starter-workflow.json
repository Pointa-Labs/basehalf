			"title": "Shot 01 storyboard frame",
			"role": "storyboard-frame",
			"prompt": "Visualize the composition, subject, lighting, and mood described in the shot plan.",
			"recipe": {
				"recipeId": "pointa.basehalf-ai-video.storyboard-frame",
				"parameters": {
					"aspect-ratio": "9:16",
					"shot-label": "Shot 01"
				},
				"inputBindings": [
