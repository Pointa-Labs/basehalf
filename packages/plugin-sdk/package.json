{
  "name": "@basehalf/plugin-sdk",
  "version": "0.1.1",
  "description": "Manifest contracts and stable host API types for BaseHalf plugins.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://plugins.basehalf.com/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pointa-Labs/basehalf.git",
    "directory": "packages/plugin-sdk"
  },
  "bugs": {
    "url": "https://github.com/Pointa-Labs/basehalf/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vscode": {
      "types": "./dist/vscode.d.ts",
      "import": "./dist/vscode.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome check src test"
  },
  "dependencies": {
    "semver": "7.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/semver": "7.7.0",
    "@types/vscode": "^1.100.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
