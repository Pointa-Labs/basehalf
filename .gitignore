# dependencies
node_modules/

# BaseHalf derived cache (rebuildable; the rest of .bh/ stays in git so
# canvas positions / badge prompts / references travel with the folder)
.bh/cache/

# This repo is BaseHalf's own source, never a content workspace — so the whole
# .bh/ that the app/demo materializes at the repo ROOT is just scratch. Anchored
# with a leading slash so it only ignores the root one; real nested workspace
# .bh/ (per the line above) still commits normally.
/.bh/

# build output
dist/
build/
out/
.turbo/
*.tsbuildinfo

# logs / env / OS cruft
*.log
.env
.env.*
.DS_Store

# internal/strategy docs — never commit (kept locally only)
private-docs/

# local reference checkouts for UI study (third-party source, kept local only,
# never committed — IP hygiene + keeps the repo small)
reference/

# Claude Code runtime state (scheduled task locks, etc.)
.claude/
