{
  "name": "@basehalf/plugin-cli",
  "version": "0.2.0",
  "description": "Create, validate, authenticate, and publish BaseHalf plugins.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://plugins.basehalf.com/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pointa-Labs/basehalf.git",
    "directory": "packages/plugin-cli"
  },
  "bugs": {
    "url": "https://github.com/Pointa-Labs/basehalf/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "bh-plugin": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "lint": "biome check src test"
  },
  "dependencies": {
    "@basehalf/plugin-sdk": "workspace:*",
    "@vscode/vsce": "3.6.2",
    "yauzl": "2.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22",
    "@types/yauzl": "2.10.3",
    "@types/vscode": "^1.100.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
