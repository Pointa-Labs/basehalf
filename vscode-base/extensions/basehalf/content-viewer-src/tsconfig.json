{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": [
			"es2024",
			"DOM",
			"DOM.Iterable"
		],
		"skipLibCheck": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"jsxImportSource": "preact"
	},
	"include": [
		"./**/*.ts",
		"./**/*.tsx"
	]
}
