{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "dist/node",
    "tsBuildInfoFile": "dist/node/.tsbuildinfo"
  },
  "include": [
    "src/code/**/*.ts",
    "src/platform/**/common/**/*.ts",
    "src/platform/**/electron-main/**/*.ts",
    "src/platform/**/electron-sandbox/**/*.ts",
    "src/platform/**/node/**/*.ts",
    "src/workbench/**/common/**/*.ts",
    "src/workbench/**/electron-main/**/*.ts",
    "src/workbench/**/electron-sandbox/**/*.ts",
    "electron.vite.config.ts",
    "package.json"
  ]
}
